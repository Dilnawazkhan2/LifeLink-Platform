# Copy to "LifeLink/.env" (the Android app). Public values only.
# Supabase dashboard → Project Settings → API Keys (or "API").
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Local dev server instead:   EXPO_PUBLIC_SUPABASE_URL=local
# Offline demo (mock data):   EXPO_PUBLIC_SUPABASE_URL=demo
